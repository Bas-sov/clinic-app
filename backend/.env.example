# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env в git не попадает.

# --- База данных ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clinic

# --- JWT ---
# Не короче 32 символов. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# --- Одноразовые коды входа пациента ---
LOGIN_CODE_TTL_MINUTES=5
LOGIN_CODE_MAX_ATTEMPTS=5

# --- Клиника ---
# Часовой пояс, в котором хранится расписание (schedule: DATE + TIME без пояса)
CLINIC_TIMEZONE=Europe/Moscow

# --- Файлы анализов ---
UPLOAD_DIR=./uploads

# --- CORS (адреса фронтенда через запятую) ---
CORS_ORIGINS=http://localhost:5173
